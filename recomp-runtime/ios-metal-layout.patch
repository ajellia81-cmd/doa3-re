+
+- (void)didMoveToWindow
+{
+    [super didMoveToWindow];
+    if (!self.window) {
+        [self.doaRefreshLink invalidate];
+        self.doaRefreshLink = nil;
+    }
+}
+
+- (void)updateDoaRefreshRate
+{
+    const bool highRate = SDL_GetHintBoolean("DOA3_IOS_SMOOTH_REFRESH", false);
+    if (!highRate || self.window.screen.maximumFramesPerSecond < 120) {
+        [self.doaRefreshLink invalidate];
+        self.doaRefreshLink = nil;
+    } else if (!self.doaRefreshLink) {
+        self.doaRefreshLink = [self.window.screen displayLinkWithTarget:self selector:@selector(doaRefreshTick:)];
+        self.doaRefreshLink.preferredFrameRateRange = CAFrameRateRangeMake(120.0, 120.0, 120.0);
+        [self.doaRefreshLink addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
+    }
+}
+
+// Reconcile the fullscreen root view before obtaining each drawable.
+- (void)syncFullscreenDrawable
+{
+    UIWindow *window = self.window;
+    if (!window || !self.superview || window.rootViewController.view != self) return;
+    CGRect frame = [self.superview convertRect:window.bounds fromView:window];
+    if (!CGRectIsEmpty(frame) && !CGRectEqualToRect(self.frame, frame)) self.frame = frame;
+    if (self.layer.contentsScale != window.screen.nativeScale)
+        self.layer.contentsScale = window.screen.nativeScale;
+    [self updateDoaRefreshRate];
+    [self updateDrawableSize];
 }
 
